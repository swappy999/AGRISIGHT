# ── Secrets & Environment Variables ──────────────────────────────
# NEVER commit secrets. These files hold API keys, service-role tokens,
# and DB credentials that would give attackers full access.
.env
.env.*
!.env.example
!.env.*.example
client_secret_*.json

# ── Python / FastAPI backend ──────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
wheels/
pip-wheel-metadata/
*.manifest
*.spec
.installed.cfg
*.egg-link
.eggs/
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# pytest
.pytest_cache/
.cache/
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# SQLite local databases (dev only, not for version control)
*.db
*.sqlite
*.sqlite3

# Uploads
backend/app/uploads/*
!backend/app/uploads/.gitkeep

