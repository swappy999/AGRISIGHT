# AgriSight — Environment Configuration Template
# For production and local development, copy this file to .env.local (frontend) or .env (backend)
# and populate with your own service credentials. NEVER commit real credentials to GitHub.

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# API Backend Configuration
NEXT_PUBLIC_API_URL=https://your-backend-api.onrender.com
NEXT_PUBLIC_APP_ENV=production

# Weather Service Configuration (Optional)
NEXT_PUBLIC_WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# Backend Gemini API Key (Backend .env)
GEMINI_API_KEY=your-google-gemini-api-key
